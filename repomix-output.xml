            ) : peopleWithBalance.length === 0 ? (
              <Card>
                <EmptyState 
                  icon={Icons.check}
                  title="Zero Balances"
                  subtitle="You have no outstanding debts or loans with any individual contacts."
                />
              </Card>
            ) : (
              <Card>
                {peopleWithBalance.map((p, i) => {
                  const net = p.net_balance;
