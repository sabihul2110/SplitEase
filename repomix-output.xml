// SplitEase/mobile/src/screens/activity/ActivityScreen.jsx


import React, { useState, useCallback } from "react";
import {
  View,
  Text,
  StyleSheet,
  SectionList,
  TouchableOpacity,
  RefreshControl,
  TextInput,
  ScrollView,
