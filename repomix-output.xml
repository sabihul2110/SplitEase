  defaultToggleText: { fontSize: 10, color: COLORS.text3, fontWeight: FONT_WEIGHT.semibold },
  defaultToggleTextOn: { color: COLORS.success },
  removeX: { fontSize: FONT_SIZE.md, color: COLORS.danger },
