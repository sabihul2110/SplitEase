}

function SubmitBtn({ label, color, loading, onPress, disabled }) {
  return (
    <TouchableOpacity
      style={[styles.submitBtn, { backgroundColor: color, shadowColor: color }, (disabled || loading) && { opacity: 0.55 }]}
      onPress={onPress}
