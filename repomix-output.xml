  return (
    <SafeAreaView style={[styles.safe, style]} edges={['left', 'right', 'bottom']}>
      {/* 🔥 Make status bar translucent to draw behind it seamlessly */}
      <StatusBar
        barStyle="light-content"
        backgroundColor="transparent"
        translucent={true}
