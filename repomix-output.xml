    conn = get_connection()
    cur  = conn.cursor(dictionary=True)
    cur.execute(
        "SELECT subcategory_id, subcategory_name FROM Subcategories WHERE category_id = %s ORDER BY subcategory_id ASC",
        (category_id,),
    )
    rows = cur.fetchall()
    cur.close(); conn.close()
    return rows


