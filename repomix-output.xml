          <div className="stat-val" style={{ color: "var(--success)" }}>
            {groups.length}
          </div>
        </div>
        <div className="stat-card">
          <div className="stat-label2">Admins</div>
          <div className="stat-val">
            {users.filter((u) => u.role === "admin").length}
