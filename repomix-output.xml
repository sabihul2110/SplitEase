      {/* Recent users */}
      <div className="card" style={{ marginBottom: 16 }}>
        <div
          style={{
            padding: "14px 18px",
            borderBottom: "1px solid var(--border)",
            fontSize: 14,
            fontWeight: 600,
          }}
        >
          Recent Users
        </div>
        <div className="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Joined</th>
              </tr>
            </thead>
            <tbody>
              {users.slice(0, 5).map((u) => (
                <tr key={u.user_id}>
                  <td style={{ fontWeight: 600 }}>{u.name}</td>
