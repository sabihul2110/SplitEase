            activeColor={C.primary}
          />
        )}
      </Field>

      {subcats.length > 0 && (
        <Field label="Subcategory" optional>
          <Dropdown
            value={subcategoryId}
            options={[{ id: null, label: 'None' }, ...subcats.map(s => ({ id: s.subcategory_id, label: s.subcategory_name }))]}
