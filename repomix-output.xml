print(f"\n{'═'*50}")
passed = total - failed
symbol = PASS if failed == 0 else FAIL
print(f"  {symbol} {passed}/{total} passed  |  {failed} failed")
print(f"{'═'*50}\n")
sys.exit(0 if failed == 0 else 1)
