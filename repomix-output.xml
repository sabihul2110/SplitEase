            <Card style={{ padding: 24, borderLeft: "4px solid var(--warning)" }}>
              <div style={{ fontSize: 13, fontWeight: 700, letterSpacing: "0.06em", textTransform: "uppercase", color: "var(--text3)", marginBottom: 8 }}>
