// ─── Helpers ───────────────────────────────────────────────────────────────────
function fmtAmt(n) {
  const abs = Math.abs(Number(n || 0));
  return abs % 1 === 0
    ? abs.toLocaleString("en-IN")
    : abs.toLocaleString("en-IN", { minimumFractionDigits: 2 });
}

// ─── Avatar ────────────────────────────────────────────────────────────────────
function Avatar({ name, size = 60 }) {
  const inits = (name || "?")
    .split(" ")
    .map((w) => w[0])
    .slice(0, 2)
    .join("")
    .toUpperCase();
  return (
    <View
      style={[
        styles.avatar,
        { width: size, height: size, borderRadius: Math.round(size * 0.26) },
      ]}
