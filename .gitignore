# SplitEase/.gitignore

# =========================
# ENV / SECRETS
# =========================
# .env and .env.* match at ANY depth (no leading slash)
.env
.env.*
.secrets/

# =========================
# PYTHON
# =========================
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.venv/
venv/
env/

# =========================
# NODE
# =========================
node_modules/

# Root lockfile intentionally NOT committed — a lockfile generated on
# one platform (macOS/arm64) can cause npm to silently skip installing
# a different platform's required optional native binary (a known npm
# bug: github.com/npm/cli/issues/4828), which is exactly what broke
# Vercel's Linux build here. Each environment now generates its own
# fresh, platform-correct lockfile at install time.
package-lock.json

# build output
dist/
build/

# =========================
# CAPACITOR / ANDROID
# =========================
web/android/

# =========================
# OS FILES
# =========================
.DS_Store
Thumbs.db

# =========================
# IDE
# =========================
.vscode/
.idea/

# =========================
# LOGS
# =========================
*.log

# =========================
# TEST / CACHE
# =========================
.pytest_cache/
.mypy_cache/
coverage/

# =========================
# TREE / STRUCTURE DUMPS
# =========================
**/tree.txt
**/structure.txt
**/SplitEase.txt

# =========================
# DOCS (internal notes, not versioned)
# =========================
docs/

# =========================
# AI-TOOLING / AGENT SCAFFOLDING
# (Expo/Claude Code auto-generates these — not app source)
# =========================
.claude/
CLAUDE.md
AGENTS.md