{
  "expo": {
    "name": "SplitEase",
    "slug": "splitease",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0b0f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.splitease.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d0e14"
      },
      "package": "com.splitease.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./withAutofillFix.js",
      "expo-build-properties",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0b0f",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7644269a-572f-4859-adfa-294444863d68"
    },
    "extra": {
      "eas": {
        "projectId": "7644269a-572f-4859-adfa-294444863d68"
      }
    },
    "owner": "sabihul2110"
  }
}